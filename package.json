{
  "name": "markdown-viewer",
  "version": "1.1.0",
  "description": "A cross-platform Electron markdown viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.markdown-viewer.app",
    "productName": "Markdown Viewer",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "styles.css",
      "renderer.js",
      "node_modules/mermaid/dist/mermaid.min.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "Markdown Document",
          "role": "Viewer",
          "icon": "build/icon.icns"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Viewer",
          "icon": "build/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "sorenwacker"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorenwacker/markdown-viewer.git"
  },
  "homepage": "https://github.com/sorenwacker/markdown-viewer#readme",
  "bugs": {
    "url": "https://github.com/sorenwacker/markdown-viewer/issues"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron",
    "mermaid",
    "cross-platform"
  ],
  "author": "sorenwacker",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.6.0",
    "eslint": "^9.39.2",
    "playwright": "^1.57.0"
  },
  "dependencies": {
    "marked": "^11.0.0",
    "mermaid": "^11.15.0"
  }
}
