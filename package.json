{
  "name": "markdown-viewer",
  "version": "1.1.0",
  "description": "A cross-platform Electron markdown viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.markdown-viewer.app",
    "productName": "Markdown Viewer",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "styles.css",
      "renderer.js",
      "node_modules/mermaid/dist/mermaid.min.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "Markdown Document",
          "role": "Viewer",
          "icon": "build/icon.icns"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Viewer",
          "icon": "build/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "noreply@example.com"
    }
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron"
  ],
  "author": {
    "name": "Markdown Viewer",
    "email": "noreply@example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "marked": "^11.0.0",
    "mermaid": "^11.12.1"
  }
}
